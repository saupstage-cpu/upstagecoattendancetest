function todayStats(){
  const emps = DB.employees.filter(e=>e.status==="active" && e.permission==="Employee");
  let working=0, onBreak=0, notClocked=0, clockedOut=0, late=0, totalMin=0;
  emps.forEach(e=>{
    const st = empStatus(e.id);
    const todays = DB.attendance.filter(a=>a.employeeId===e.id && sameDay(a.timeIn,new Date()));
    if(st==="working") working++;
    else if(st==="break") onBreak++;
    else if(todays.some(a=>a.timeOut)) clockedOut++;
    else notClocked++;
    todays.forEach(a=>{
      const t = new Date(a.timeIn);
      if(t.getHours()>8 || (t.getHours()===8 && t.getMinutes()>DB.settings.lateThresholdMin)) late++;
      if(a.netMin) totalMin += a.netMin;
      else if(!a.timeOut) totalMin += mins(new Date()-new Date(a.timeIn));
    });
  });
  const missingOut = DB.attendance.filter(a=> !a.timeOut && !sameDay(a.timeIn,new Date())).length;
  return {working,onBreak,notClocked,clockedOut,late,missingOut,totalHeadcount:emps.length,totalMin};
}
function activeJobsToday(){
  return DB.jobs.filter(j=>j.status==="Active").map(j=>{
    const todays = DB.attendance.filter(a=>a.jobId===j.id && sameDay(a.timeIn,new Date()));
    const people = new Set(todays.map(a=>a.employeeId)).size;
    const hrs = todays.reduce((s,a)=> s + (a.netMin!=null? a.netMin : (!a.timeOut? mins(new Date()-new Date(a.timeIn)) : 0)), 0);
    return {job:j, people, hrs};
  }).filter(x=>x.people>0);
}

