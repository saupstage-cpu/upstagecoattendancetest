    audit(emp.name,"Requested correction",jobName(a.jobId),`Requested clock-out ${fmtTime(d.toISOString())}. Reason: ${reason}`);
    save(); wrap.remove(); toast("Correction request sent to admin"); go("emp-att-detail",{id:attId});
  };
}

