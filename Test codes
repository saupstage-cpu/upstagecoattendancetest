    const emp = currentEmployee();
    const jobId = $("wlJob").value, task = $("wlTask").value || $("wlTaskPreset").value;
    if(!task){ toast("Add a task description"); return; }
    const today = new Date();
    const [sh,sm] = ($("wlStart").value||"08:00").split(":").map(Number);
    const [fh,fm] = ($("wlFinish").value||"").split(":").map(Number);
    const start = new Date(today); start.setHours(sh,sm,0,0);
    const finish = $("wlFinish").value ? (()=>{const d=new Date(today); d.setHours(fh,fm,0,0); return d;})() : null;
    DB.worklogs.push({id:uid("wl"), attendanceId:null, employeeId:emp.id, jobId, task, start:start.toISOString(), finish: finish?finish.toISOString():null, notes:$("wlNotes").value, photos: $("wlPhotoPreview").innerHTML? 1:0});
