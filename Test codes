<!UpstageCo attendance app html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Upstage Track — Time, Attendance &amp; Job Tracking</title>
<style>
  :root{
    --ink:#12161C;
    --panel:#1B212A;
    --panel-2:#232B36;
    --line:#2C3542;
    --accent:#f4e5dd;
    --accent-dim:#3A2417;
    --ok:#2FD97B;
    --ok-dim:#123321;
    --warn:#F5B301;
    --warn-dim:#332601;
    --danger:#FF4D4D;
    --danger-dim:#3A1414;
    --text:#F5F3EE;
    --muted:#8A93A3;
    --radius:14px;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;height:100%;background:var(--ink);color:var(--text);}
  body{overscroll-behavior-y:none;}
  #app{max-width:480px;margin:0 auto;min-height:100vh;display:flex;flex-direction:column;position:relative;background:var(--ink);}
  .wide #app{max-width:1180px;}

  /* ---------- Generic ---------- */
  a{color:inherit;}
  button{font-family:inherit;}
  .btn{
    appearance:none;border:none;border-radius:12px;padding:16px 18px;font-size:16px;font-weight:700;
    cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;letter-spacing:.2px;
    transition:transform .08s ease, filter .15s ease; color:var(--text);
  }
  .btn:active{transform:scale(.97);}
  .btn-block{width:100%;}
  .btn-lg{padding:22px 18px;font-size:19px;border-radius:16px;}
  .btn-accent{background:var(--accent);color:#1B0D02;}
  .btn-ghost{background:var(--panel-2);color:var(--text);border:1px solid var(--line);}
  .btn-ok{background:var(--ok);color:#052914;}
  .btn-warn{background:var(--warn);color:#2b2000;}
  .btn-danger{background:var(--danger);color:#2b0303;}
  .btn-outline-danger{background:transparent;border:1px solid var(--danger);color:var(--danger);}
  .btn[disabled]{opacity:.35;pointer-events:none;}
  .btn-sm{padding:9px 12px;font-size:13px;border-radius:9px;}
  .row{display:flex;align-items:center;}
  .row-between{display:flex;align-items:center;justify-content:space-between;}
  .col{display:flex;flex-direction:column;}
  .gap-8{gap:8px;} .gap-12{gap:12px;} .gap-16{gap:16px;}
  .muted{color:var(--muted);}
  .small{font-size:12.5px;}
  .tiny{font-size:11px;}
  .h1{font-size:26px;font-weight:800;letter-spacing:-.3px;margin:0;}
  .h2{font-size:19px;font-weight:800;margin:0;letter-spacing:-.2px;}
  .h3{font-size:15px;font-weight:700;margin:0;color:var(--muted);}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px;}
  .card-tight{padding:12px 14px;}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:12.5px;font-weight:700;}
  .pill-ok{background:var(--ok-dim);color:var(--ok);}
  .pill-warn{background:var(--warn-dim);color:var(--warn);}
  .pill-danger{background:var(--danger-dim);color:var(--danger);}
  .pill-muted{background:var(--panel-2);color:var(--muted);}
  .dot{width:9px;height:9px;border-radius:50%;display:inline-block;}
  .dot-ok{background:var(--ok);} .dot-warn{background:var(--warn);} .dot-danger{background:var(--danger);} .dot-muted{background:var(--muted);}
  input,select,textarea{
    background:var(--panel-2);border:1px solid var(--line);color:var(--text);border-radius:10px;
    padding:13px 14px;font-size:15.5px;width:100%;font-family:inherit;
  }
  input:focus,select:focus,textarea:focus{outline:2px solid var(--accent);outline-offset:-1px;}
  label{font-size:12.5px;color:var(--muted);font-weight:700;margin-bottom:6px;display:block;text-transform:none;}
  .field{margin-bottom:14px;}
  .divider{height:1px;background:var(--line);margin:14px 0;}
  .scroll{overflow-y:auto;-webkit-overflow-scrolling:touch;}
  .topbar{position:sticky;top:0;z-index:20;background:rgba(18,22,28,.92);backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;}
  .backbtn{background:none;border:none;color:var(--text);font-size:15px;font-weight:700;display:flex;align-items:center;gap:6px;padding:4px;}
  .content{padding:16px 18px 100px;flex:1;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  table{width:100%;border-collapse:collapse;font-size:13.5px;}
  th{text-align:left;color:var(--muted);font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;padding:8px 10px;border-bottom:1px solid var(--line);}
  td{padding:10px;border-bottom:1px solid var(--line);}
  tr:last-child td{border-bottom:none;}
  .avatar{width:38px;height:38px;border-radius:50%;background:var(--panel-2);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;border:1px solid var(--line);flex-shrink:0;}
  .toast{position:fixed;bottom:110px;left:50%;transform:translateX(-50%);background:var(--panel-2);
    border:1px solid var(--line);padding:12px 18px;border-radius:12px;font-size:14px;font-weight:600;z-index:200;
    box-shadow:0 10px 30px rgba(0,0,0,.4); max-width:90%; text-align:center;}
  .modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:100;display:flex;align-items:flex-end;justify-content:center;}
  .wide .modal-bg{align-items:center;}
  .modal{background:var(--ink);width:100%;max-width:480px;border-radius:20px 20px 0 0;padding:20px;max-height:92vh;overflow-y:auto;border:1px solid var(--line);border-bottom:none;}
  .wide .modal{border-radius:16px;border-bottom:1px solid var(--line);}
  .bottomnav{position:sticky;bottom:0;background:rgba(18,22,28,.96);backdrop-filter:blur(8px);border-top:1px solid var(--line);
    display:flex;padding:8px 6px calc(8px + env(safe-area-inset-bottom));}
  .navbtn{flex:1;background:none;border:none;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px;font-size:10.5px;font-weight:700;}
  .navbtn.active{color:var(--accent);}
  .navico{font-size:19px;}
  .empty{text-align:center;padding:40px 20px;color:var(--muted);}
  .photo-thumb{width:56px;height:56px;border-radius:10px;object-fit:cover;background:var(--panel-2);border:1px solid var(--line);}
  video,canvas{width:100%;border-radius:14px;background:#000;}
  .flowbig{font-size:44px;font-weight:800;letter-spacing:-1px;}
  ::-webkit-scrollbar{display:none;}
  .link{color:var(--accent);font-weight:700;text-decoration:none;cursor:pointer;}
  .badge-req{color:var(--accent);font-weight:800;}
  .sidebar{display:none;}
  .wide .layout{display:flex;}
  .wide .sidebar{display:flex;flex-direction:column;width:220px;flex-shrink:0;border-right:1px solid var(--line);padding:20px 12px;gap:4px;min-height:100vh;}
  .wide .main{flex:1;min-width:0;}
  .wide .bottomnav{display:none;}
  .sidebtn{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:10px;background:none;border:none;color:var(--muted);font-weight:700;font-size:14px;text-align:left;width:100%;}
  .sidebtn.active{background:var(--accent-dim);color:var(--accent);}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;flex:1;min-width:110px;}
  .kpi .num{font-size:24px;font-weight:800;}
  .kpi .lab{font-size:11.5px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.3px;}
  .flexwrap{display:flex;flex-wrap:wrap;gap:10px;}
</style>
</head>
<body>
<div id="app"></div>
<script>
/* =====================================================================
   UPSTAGE TRACK — functional prototype
   Single-file demo app. All data is stored in this browser's localStorage
   to simulate a cloud database so the full workflow can be tested end to
   end without any backend. See the accompanying README for what a real
   production build would need to change.
   ===================================================================== */

const KEY = "upstage_track_db_v1";

function uid(prefix){ return prefix + "_" + Math.random().toString(36).slice(2,9); }
function nowISO(){ return new Date().toISOString(); }
function fmtTime(iso){ if(!iso) return "—"; return new Date(iso).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'}); }
function fmtDate(iso){ return new Date(iso).toLocaleDateString([], {weekday:'short',day:'numeric',month:'short'}); }
function fmtDateShort(iso){ return new Date(iso).toLocaleDateString([], {day:'2-digit',month:'2-digit',year:'2-digit'}); }
function mins(ms){ return Math.round(ms/60000); }
function hm(totalMins){
  totalMins = Math.max(0, Math.round(totalMins));
  const h = Math.floor(totalMins/60), m = totalMins%60;
  return (h>0? h+"h ":"") + m+"m";
}
function startOfWeek(d=new Date()){
  const dt = new Date(d); const day = (dt.getDay()+6)%7; // Monday start
  dt.setHours(0,0,0,0); dt.setDate(dt.getDate()-day); return dt;
}
function sameDay(a,b){ const x=new Date(a),y=new Date(b); return x.toDateString()===y.toDateString(); }
function initials(name){ return name.split(" ").map(s=>s[0]).slice(0,2).join("").toUpperCase(); }
function escapeHtml(s){ return (s||"").replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }

/* ---------------- Demo data ---------------- */
function seed(){
  const employees = [
    {id:"emp_alex", empId:"EMP-001", name:"Alex Rivera", role:"Site Crew", pin:"1111", status:"active", email:"alex@upstage.co", department:"Production", payCategory:"Casual", employmentType:"Casual", hourlyRate:34.50, manager:"Julia Santos", defaultLocation:"Upstage Workshop", permission:"Employee"},
    {id:"emp_shadelle", empId:"EMP-002", name:"Shadelle Nguyen", role:"Rigger", pin:"1111", status:"active", email:"shadelle@upstage.co", department:"Production", payCategory:"Casual", employmentType:"Casual", hourlyRate:38.00, manager:"Julia Santos", defaultLocation:"Upstage Workshop", permission:"Employee"},
    {id:"emp_chris", empId:"EMP-003", name:"Chris Doyle", role:"Fabricator", pin:"1111", status:"active", email:"chris@upstage.co", department:"Workshop", payCategory:"Full-time", employmentType:"Full Time", hourlyRate:36.00, manager:"Julia Santos", defaultLocation:"Upstage Workshop", permission:"Employee"},
    {id:"emp_julia", empId:"EMP-004", name:"Julia Santos", role:"Site Manager", pin:"1111", status:"active", email:"julia@upstage.co", department:"Production", payCategory:"Full-time", employmentType:"Full Time", hourlyRate:42.00, manager:"—", defaultLocation:"Upstage Workshop", permission:"Manager"},
    {id:"emp_bodhi", empId:"EMP-005", name:"Bodhi Marsh", role:"Labourer", pin:"1111", status:"active", email:"bodhi@upstage.co", department:"Production", payCategory:"Casual", employmentType:"Casual", hourlyRate:32.00, manager:"Julia Santos", defaultLocation:"Upstage Workshop", permission:"Employee"},
    {id:"emp_joel", empId:"EMP-006", name:"Joel Kaine", role:"Electrician", pin:"1111", status:"active", email:"joel@upstage.co", department:"Production", payCategory:"Casual", employmentType:"Casual", hourlyRate:40.00, manager:"Julia Santos", defaultLocation:"Upstage Workshop", permission:"Employee"},
    {id:"emp_will", empId:"EMP-007", name:"Will Foster", role:"Office / Admin", pin:"1111", status:"active", email:"will@upstage.co", department:"Office", payCategory:"Full-time", employmentType:"Full Time", hourlyRate:35.00, manager:"Julia Santos", defaultLocation:"Upstage HQ", permission:"Payroll"},
  ];
  const superAdmin = {id:"admin_super", empId:"ADM-000", name:"Rosa Alvear", role:"Founder / Super Admin", pin:"9999", status:"active", email:"rosa@upstage.co", department:"Management", payCategory:"—", employmentType:"—", hourlyRate:null, manager:"—", defaultLocation:"Upstage HQ", permission:"Super Admin"};
  const jobs = [
    {id:"job_ateez", number:"2026-001", name:"ATEEZ Tour", client:"Live Nation", venue:"Accor Stadium", location:"Sydney, NSW", start:"2026-08-10", end:"2026-08-20", manager:"Julia Santos", status:"Active", notes:"Load-in Aug 10, show Aug 18, pack-down Aug 19-20.", assigned:["emp_alex","emp_shadelle","emp_bodhi","emp_joel","emp_julia"]},
    {id:"job_foo", number:"2026-002", name:"Foo Fighters Australia", client:"Live Nation", venue:"Marvel Stadium", location:"Melbourne, VIC", start:"2026-09-01", end:"2026-09-06", manager:"Julia Santos", status:"Upcoming", notes:"", assigned:["emp_alex","emp_joel"]},
    {id:"job_workshop", number:"WS-000", name:"Workshop", client:"Internal", venue:"Upstage Workshop", location:"Cebu City", start:"2026-01-01", end:"", manager:"Chris Doyle", status:"Active", notes:"General fabrication and maintenance.", assigned:["emp_chris","emp_bodhi"]},
    {id:"job_accor", number:"2026-003", name:"Accor Stadium — Rigging", client:"Accor Stadium", venue:"Accor Stadium", location:"Sydney, NSW", start:"2026-07-01", end:"2026-07-15", manager:"Julia Santos", status:"Completed", notes:"", assigned:["emp_shadelle"]},
    {id:"job_office", number:"OFF-000", name:"General Office", client:"Internal", venue:"Upstage HQ", location:"Cebu City", start:"2026-01-01", end:"", manager:"Will Foster", status:"Active", notes:"", assigned:["emp_will","emp_julia"]},
  ];

  const attendance = []; const worklogs = []; const auditLogs = []; const timesheets = [];
  const TASK_CATEGORIES_SEED = ["Site / Bump In","Workshop","Warehouse / Prep","Pack Down","Office / Admin"];
  const today = new Date();
  function mk(empId, jobId, dayOffset, inH,inM,outH,outM, hasBreak, task){
    const d = new Date(today); d.setDate(d.getDate()-dayOffset);
    const ti = new Date(d); ti.setHours(inH,inM,0,0);
    const to = new Date(d); to.setHours(outH,outM,0,0);
    const attId = uid("att");
    const breaks = [];
    let unpaidMin = 0, paidMin = 0;
    if(hasBreak){
      const b1s = new Date(ti.getTime()+2*3600000); const b1e = new Date(b1s.getTime()+20*60000);
      const b2s = new Date(ti.getTime()+4.5*3600000); const b2e = new Date(b2s.getTime()+30*60000);
      breaks.push({id:uid("brk"), attendanceId:attId, type:"Morning Tea", start:b1s.toISOString(), end:b1e.toISOString(), paid:true, gpsStart:{lat:-33.847,lng:151.063}, gpsEnd:{lat:-33.847,lng:151.063}});
      breaks.push({id:uid("brk"), attendanceId:attId, type:"Lunch", start:b2s.toISOString(), end:b2e.toISOString(), paid:false, gpsStart:{lat:-33.847,lng:151.063}, gpsEnd:{lat:-33.847,lng:151.063}});
      paidMin = 20; unpaidMin = 30;
    }
    const grossMin = mins(to-ti);
    const netMin = grossMin - unpaidMin;
    attendance.push({
      id:attId, employeeId:empId, jobId, timeIn:ti.toISOString(), timeOut: dayOffset===0? null : to.toISOString(),
      photoIn:"PHOTO", photoOut: dayOffset===0? null : "PHOTO",
      gpsIn:{lat:-33.8474,lng:151.0629,address:"Accor Stadium, Sydney Olympic Park NSW"},
      gpsOut: dayOffset===0? null : {lat:-33.8474,lng:151.0629,address:"Accor Stadium, Sydney Olympic Park NSW"},
      geofence:"inside", breakIds:breaks.map(b=>b.id), grossMin, unpaidBreakMin:unpaidMin, paidBreakMin:paidMin, netMin: dayOffset===0? null : netMin,
      category: TASK_CATEGORIES_SEED[dayOffset%TASK_CATEGORIES_SEED.length], device:"iOS · iPhone",
      status: dayOffset===0? "open" : (dayOffset<=1? "submitted" : "approved"), source:"app", summary:task
    });
    breaks.forEach(b=>attendance.push); // no-op, breaks stored separately below
    breaksStore.push(...breaks);
    worklogs.push({id:uid("wl"), attendanceId:attId, employeeId:empId, jobId, task, start:ti.toISOString(), finish: dayOffset===0?null:to.toISOString(), notes:"", photos: dayOffset%2===0?1:0});
  }
  const breaksStore = [];
  mk("emp_alex","job_ateez",0,7,58,0,0,true,"Building 2m x 2m risers");
  mk("emp_alex","job_ateez",1,8,2,17,10,true,"Loaded truck, unloaded rigging");
  mk("emp_alex","job_ateez",2,7,55,16,40,true,"Installed stairs");
  mk("emp_shadelle","job_ateez",0,7,45,0,0,true,"Rigging point survey");
  mk("emp_shadelle","job_ateez",1,7,50,18,5,true,"Hung motor points");
  mk("emp_chris","job_workshop",0,8,30,0,0,true,"Workshop fabrication — deck frames");
  mk("emp_chris","job_workshop",1,8,25,17,0,true,"CAD drawings for stage deck v3");
  mk("emp_julia","job_ateez",0,7,30,0,0,false,"Site coordination");
  mk("emp_bodhi","job_workshop",1,8,58,17,20,true,"Maintenance — forklift service");
  mk("emp_joel","job_ateez",2,8,0,16,30,true,"Site preparation, power distro");
  mk("emp_will","job_office",1,9,1,17,30,true,"Payroll admin, timesheet review");

  const settings = {
    companyName:"Upstage Co", timezone:"Australia/Sydney", workWeekStart:"Monday",
    standardHours:8, requirePhoto:true, requireGPS:true,
    geofenceEnforced:false, lateThresholdMin:10, overtimeThresholdHrs:8,
    autoClockOutHrs:12, galleryUploadAllowed:false, backgroundTracking:false,
    breakRules:[
      {id:"br1", name:"Morning Tea (Smoko)", minutes:20, paid:true},
      {id:"br2", name:"Lunch", minutes:30, paid:false}
    ],
    geofences:[
      {id:"geo1", name:"Upstage Workshop", lat:10.3157, lng:123.8854, radiusM:200},
      {id:"geo2", name:"Accor Stadium", lat:-33.8474, lng:151.0629, radiusM:300}
    ],
    xero:{connected:false, lastSync:null, tenant:null},
    notifications:{forgotTimeOut:true, shiftStarting:true, breakExceeded:true, timesheetCorrection:true, timesheetApproved:true, timesheetRejected:true, adminCorrection:true, xeroSyncFailure:true}
  };

  employees.push(superAdmin);
  auditLogs.push({id:uid("aud"), actor:"System", action:"Seed data generated", target:"Database", detail:"Demo dataset created for Upstage Co.", ts:nowISO()});

  return {employees, jobs, attendance, breaks:breaksStore, worklogs, timesheets, correctionRequests:[], auditLogs, settings, notifications:[], session:null};
}

function loadDB(){
  const raw = localStorage.getItem(KEY);
  if(raw){ try{ return JSON.parse(raw); }catch(e){} }
  const db = seed();
  localStorage.setItem(KEY, JSON.stringify(db));
  return db;
}
let DB = loadDB();
function save(){ localStorage.setItem(KEY, JSON.stringify(DB)); }
function isAdminRole(perm){ return perm && perm!=="Employee"; }
/* Which admin tabs each permission level can see */
const ROLE_TAB_ACCESS = {
  "Super Admin": ["admin-dashboard","admin-employees","admin-jobs","admin-live","admin-timesheets","admin-reports","admin-payroll","admin-notifications","admin-audit","admin-xero","admin-settings"],
  "Admin":       ["admin-dashboard","admin-employees","admin-jobs","admin-live","admin-timesheets","admin-reports","admin-payroll","admin-notifications","admin-audit","admin-xero","admin-settings"],
  "Manager":     ["admin-dashboard","admin-employees","admin-jobs","admin-live","admin-timesheets","admin-reports","admin-notifications"],
  "Payroll":     ["admin-dashboard","admin-reports","admin-payroll","admin-notifications"],
};
function canAccess(tab){
  const role = DB.session?.role;
  if(!isAdminRole(role)) return false;
  return (ROLE_TAB_ACCESS[role]||[]).includes(tab);
}
function firstAllowedTab(role){ return (ROLE_TAB_ACCESS[role]||["admin-dashboard"])[0]; }
function audit(actor, action, target, detail){
  DB.auditLogs.unshift({id:uid("aud"), actor, action, target, detail, ts:nowISO()});
  save();
}

/* ---------------- Router / State ---------------- */
let route = {name:"login"};
let toastTimer = null;
function toast(msg){
  const el = document.createElement("div");
  el.className="toast"; el.textContent=msg;
  document.body.appendChild(el);
  clearTimeout(toastTimer);
  setTimeout(()=>el.remove(), 2600);
}
function go(name, params={}){ route = {name, ...params}; render(); window.scrollTo(0,0); }

function currentEmployee(){ return DB.employees.find(e=>e.id===DB.session?.employeeId); }
function isWide(){ return document.body.classList.contains("wide"); }

/* ---------------- Derived helpers ---------------- */
function empOpenAttendance(empId){
  return DB.attendance.find(a=>a.employeeId===empId && !a.timeOut);
}
function empOpenBreak(attId){
  return DB.breaks.find(b=>b.attendanceId===attId && !b.end);
}
function empStatus(empId){
  const att = empOpenAttendance(empId);
  if(!att) return "off";
  if(empOpenBreak(att.id)) return "break";
  return "working";
}
function jobName(id){ const j=DB.jobs.find(j=>j.id===id); return j? j.name : "—"; }
function empName(id){ const e=DB.employees.find(e=>e.id===id); return e? e.name : "—"; }
function empRecordsForWeek(empId, weekStart){
  const end = new Date(weekStart); end.setDate(end.getDate()+7);
  return DB.attendance.filter(a=>a.employeeId===empId && new Date(a.timeIn)>=weekStart && new Date(a.timeIn)<end);
}
function weeklyNetMinutes(empId, weekStart){
  return empRecordsForWeek(empId, weekStart).reduce((s,a)=> s + (a.netMin || (a.timeOut? mins(new Date(a.timeOut)-new Date(a.timeIn)) - (a.unpaidBreakMin||0) : 0)),0);
}
function todayNetMinutes(empId){
  const att = DB.attendance.filter(a=>a.employeeId===empId && sameDay(a.timeIn, new Date()));
  return att.reduce((s,a)=>{
    if(a.netMin!=null) return s+a.netMin;
    if(!a.timeOut) return s; // still open, don't count yet in "today" total until timeout (live timer handles current one)
    return s;
  },0);
}

/* ---------------- Geolocation & reverse geocode ---------------- */
function getPosition(){
  return new Promise((resolve)=>{
    if(!navigator.geolocation){ resolve(null); return; }
    navigator.geolocation.getCurrentPosition(
      pos=> resolve({lat:pos.coords.latitude, lng:pos.coords.longitude, accuracy:pos.coords.accuracy}),
      err=> resolve(null),
      {enableHighAccuracy:true, timeout:8000}
    );
  });
}
async function reverseGeocode(lat,lng){
  try{
    const r = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=16`, {headers:{"Accept":"application/json"}});
    const j = await r.json();
    return j.display_name || `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
  }catch(e){
    return `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
  }
}
function distMeters(lat1,lng1,lat2,lng2){
  const R=6371000, toRad=d=>d*Math.PI/180;
  const dLat=toRad(lat2-lat1), dLng=toRad(lng2-lng1);
  const a=Math.sin(dLat/2)**2 + Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLng/2)**2;
  return R*2*Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}
function geofenceCheck(lat,lng){
  for(const g of DB.settings.geofences){
    if(distMeters(lat,lng,g.lat,g.lng) <= g.radiusM) return {inside:true, name:g.name};
  }
  return {inside:false, name:null};
}

/* ---------------- Camera capture modal ---------------- */
function openCamera(onCapture, title){
  const wrap = document.createElement("div");
  wrap.className = "modal-bg";
  wrap.innerHTML = `
    <div class="modal">
      <div class="row-between" style="margin-bottom:12px;">
        <div class="h2">${title||"Take Photo"}</div>
        <button class="btn btn-ghost btn-sm" id="camClose">Cancel</button>
      </div>
      <video id="camVideo" autoplay playsinline muted></video>
      <canvas id="camCanvas" style="display:none;"></canvas>
      <div class="col gap-8" style="margin-top:14px;">
        <button class="btn btn-accent btn-block btn-lg" id="camShoot">📷 Capture Photo</button>
        <div class="tiny muted" style="text-align:center;">Live camera only — gallery uploads are disabled by admin policy.</div>
      </div>
    </div>`;
  document.body.appendChild(wrap);
  const video = wrap.querySelector("#camVideo");
  let stream = null;
  navigator.mediaDevices?.getUserMedia({video:{facingMode:"user"}, audio:false})
    .then(s=>{ stream=s; video.srcObject=s; })
    .catch(()=>{ video.replaceWith(Object.assign(document.createElement("div"), {className:"empty", innerHTML:"Camera unavailable in this browser/context.<br><br><button class='btn btn-ghost' id='camFallback'>Use placeholder photo</button>"})); 
      wrap.querySelector("#camFallback")?.addEventListener("click", ()=>{ finish("PHOTO_PLACEHOLDER"); });
    });
  function finish(dataUrl){
    stream?.getTracks().forEach(t=>t.stop());
    wrap.remove();
    onCapture(dataUrl);
  }
  wrap.querySelector("#camClose").addEventListener("click", ()=>{ stream?.getTracks().forEach(t=>t.stop()); wrap.remove(); });
  wrap.querySelector("#camShoot").addEventListener("click", ()=>{
    const canvas = wrap.querySelector("#camCanvas");
    canvas.width = video.videoWidth||320; canvas.height = video.videoHeight||240;
    canvas.getContext("2d").drawImage(video,0,0,canvas.width,canvas.height);
    const dataUrl = canvas.toDataURL("image/jpeg",0.7);
    finish(dataUrl);
  });
}

