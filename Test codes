function runReport(){
  const $ = id=>document.getElementById(id);
  const empId = $("repEmp").value, jobId = $("repJob").value, status=$("repStatus").value;
  const from = $("repFrom").value ? new Date($("repFrom").value) : null;
  const to = $("repTo").value ? new Date($("repTo").value+"T23:59:59") : null;
  let rows = DB.attendance.slice();
  if(empId) rows = rows.filter(a=>a.employeeId===empId);
  if(jobId) rows = rows.filter(a=>a.jobId===jobId);
  if(status) rows = rows.filter(a=>a.status===status);
  if(from) rows = rows.filter(a=>new Date(a.timeIn)>=from);
  if(to) rows = rows.filter(a=>new Date(a.timeIn)<=to);
  rows.sort((a,b)=>new Date(b.timeIn)-new Date(a.timeIn));
  const totalNet = rows.reduce((s,a)=>s+(a.netMin||0),0);
  window.__lastReport = rows;
  document.getElementById("reportResults").innerHTML = `
    <div class="row-between" style="margin:16px 0 10px;"><div class="h3">${rows.length} RECORDS · ${hm(totalNet)} TOTAL</div>
      <div class="row gap-8">
        <button class="btn btn-ghost btn-sm" id="expCsv">Export CSV</button>
        <button class="btn btn-ghost btn-sm" id="expPdf">Export PDF</button>
      </div>
    </div>
    <table>
      <tr><th>Date</th><th>Employee</th><th>Job</th><th>In</th><th>Out</th><th>Net</th><th>Status</th></tr>
      ${rows.map(a=>`<tr><td>${fmtDateShort(a.timeIn)}</td><td>${escapeHtml(empName(a.employeeId))}</td><td>${escapeHtml(jobName(a.jobId))}</td>
        <td>${fmtTime(a.timeIn)}</td><td>${a.timeOut?fmtTime(a.timeOut):'—'}</td><td>${a.netMin!=null?hm(a.netMin):'—'}</td><td>${a.status}</td></tr>`).join("")}
    </table>`;
  document.getElementById("expCsv").onclick = exportCSV;
  document.getElementById("expPdf").onclick = ()=> toast("A production build renders this via a PDF service (e.g. server-side Puppeteer or a PDF library) — CSV export is fully functional now.");
}
function exportCSV(){
  const rows = window.__lastReport||[];
  const header = ["Date","Employee","Job","Time In","Time Out","Gross Min","Unpaid Break Min","Net Min","Status"];
  const lines = [header.join(",")];
  rows.forEach(a=>{
    lines.push([fmtDateShort(a.timeIn), empName(a.employeeId), jobName(a.jobId), fmtTime(a.timeIn), a.timeOut?fmtTime(a.timeOut):"", a.grossMin||"", a.unpaidBreakMin||0, a.netMin||"", a.status].map(v=>`"${String(v).replace(/"/g,'""')}"`).join(","));
  });
  const blob = new Blob([lines.join("\n")], {type:"text/csv"});
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a"); link.href=url; link.download="upstage_timesheet_report.csv"; link.click();
  audit(DB.session.name,"Exported report","Reports",`${rows.length} rows`); save();
}

