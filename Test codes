}

/* ---------------- Admin bindings ---------------- */
function bindAdminScreen(){
  const $ = id=>document.getElementById(id);
  if($("back")) $("back").onclick = ()=> go(route.name==="admin-att-detail"||route.name==="admin-employee-detail" ? "admin-employees" : "admin-dashboard");

  document.querySelectorAll("[data-nav]").forEach(b=> b.onclick = ()=> go(b.dataset.nav));
  document.querySelectorAll("[data-emp]").forEach(tr=> tr.onclick = ()=> go("admin-employee-detail",{id:tr.dataset.emp}));
  document.querySelectorAll("[data-job2]").forEach(c=> c.onclick = ()=> go("admin-job-detail",{id:c.dataset.job2}));
  document.querySelectorAll("[data-att]").forEach(el=> el.onclick = ()=> go("admin-att-detail",{id:el.dataset.att}));

  if($("addEmp")) $("addEmp").onclick = ()=> modalAddEmployee();
  if($("addJob")) $("addJob").onclick = ()=> modalAddJob();
  if($("resetPin")) $("resetPin").onclick = ()=>{ const e=DB.employees.find(x=>x.id===route.id); audit(DB.session.name,"Reset PIN",e.name,"PIN reset to default 1111"); toast("PIN reset — employee notified"); };
  if($("toggleActive")) $("toggleActive").onclick = ()=>{ const e=DB.employees.find(x=>x.id===route.id); e.status = e.status==='active'?'disabled':'active'; audit(DB.session.name, e.status==='active'?"Re-enabled employee":"Disabled employee", e.name,""); save(); go("admin-employee-detail",{id:e.id}); };
  if($("manualEntry")) $("manualEntry").onclick = ()=> modalManualEntry(route.id);

  if($("approveBtn")) $("approveBtn").onclick = ()=> setAttStatus(route.id,"approved");
  if($("rejectBtn")) $("rejectBtn").onclick = ()=> setAttStatus(route.id,"rejected-needs-fix");
  if($("correctBtn")) $("correctBtn").onclick = ()=> { toast("Correction request sent to employee"); audit(DB.session.name,"Requested correction",empName(DB.attendance.find(a=>a.id===route.id).employeeId),""); };
  if($("editApproved")) $("editApproved").onclick = ()=> modalEditApproved(route.id);

  document.querySelectorAll("[data-approve]").forEach(b=> b.onclick = ()=> { setAttStatus(b.dataset.approve,"approved"); });
  document.querySelectorAll("[data-reject]").forEach(b=> b.onclick = ()=> { setAttStatus(b.dataset.reject,"rejected"); });
  document.querySelectorAll("[data-cr-approve]").forEach(b=> b.onclick = ()=>{
    const r = DB.correctionRequests.find(x=>x.id===b.dataset.crApprove);
    const a = DB.attendance.find(x=>x.id===r.attendanceId);
    const originalOut = fmtTime(a.timeOut);
    a.timeOut = r.requestedTimeOut;
    a.grossMin = mins(new Date(a.timeOut)-new Date(a.timeIn));
    a.netMin = a.grossMin - (a.unpaidBreakMin||0);
    a.status = "corrected"; r.status="approved";
    audit(DB.session.name,"Approved correction request", empName(r.employeeId), `Original: ${originalOut} → Corrected: ${fmtTime(a.timeOut)}. Reason: ${r.reason}`);
    save(); toast("Correction approved"); go("admin-timesheets");
  });
  document.querySelectorAll("[data-cr-reject]").forEach(b=> b.onclick = ()=>{
    const r = DB.correctionRequests.find(x=>x.id===b.dataset.crReject);
    r.status="rejected";
    audit(DB.session.name,"Rejected correction request", empName(r.employeeId), r.reason);
    save(); toast("Correction request rejected"); go("admin-timesheets");
  });

  if($("xeroToggle")) $("xeroToggle").onclick = ()=>{
    const x = DB.settings.xero;
    if(x.connected){ x.connected=false; x.tenant=null; audit(DB.session.name,"Disconnected Xero","Xero Integration",""); }
    else { x.connected=true; x.tenant="Upstage Co Pty Ltd"; x.lastSync=null; audit(DB.session.name,"Connected Xero (demo)","Xero Integration","Simulated OAuth — no real Xero credentials used"); toast("Connected (demo simulation — see note below)"); }
    save(); go("admin-xero");
  };
  if($("syncBtn")) $("syncBtn").onclick = ()=>{
    const approvedCount = DB.attendance.filter(a=>a.status==="approved").length;
    DB.settings.xero.lastSync = nowISO();
    audit(DB.session.name,"Synced timesheets to Xero (demo)","Xero Integration",`${approvedCount} approved records`);
    save(); toast(`Synced ${approvedCount} approved timesheets (simulated)`); go("admin-xero");
  };
  if($("syncHistory")) $("syncHistory").onclick = ()=> go("admin-audit");
  if($("viewPrivacyAdmin")) $("viewPrivacyAdmin").onclick = ()=> { PRIVACY_FROM_LOGIN=false; go("privacy"); };
  if($("ackBtn")) $("ackBtn").onclick = ()=> go("admin-settings");

  document.querySelectorAll("[data-notif]").forEach(cb=> cb.onchange = ()=>{ DB.settings.notifications[cb.dataset.notif]=cb.checked; save(); });
  if($("reqPhoto")) $("reqPhoto").onchange = ()=>{ DB.settings.requirePhoto=$("reqPhoto").checked; save(); };
  if($("reqGps")) $("reqGps").onchange = ()=>{ DB.settings.requireGPS=$("reqGps").checked; save(); };
  if($("reqGeo")) $("reqGeo").onchange = ()=>{ DB.settings.geofenceEnforced=$("reqGeo").checked; save(); toast("Geofence enforcement " + ($("reqGeo").checked?"enabled":"disabled")); };
  if($("reqGallery")) $("reqGallery").onchange = ()=>{ DB.settings.galleryUploadAllowed=$("reqGallery").checked; save(); };

  if($("runReport")) $("runReport").onclick = runReport;
}

function setAttStatus(attId, status){
  if(status==="rejected"){ modalReject(attId); return; }
  const a = DB.attendance.find(x=>x.id===attId);
  a.status = status;
  audit(DB.session.name,"Approved timesheet", empName(a.employeeId), fmtDate(a.timeIn));
  save(); toast("Approved"); go(route.name);
}
function modalReject(attId){
  const a = DB.attendance.find(x=>x.id===attId);
  const wrap = document.createElement("div"); wrap.className="modal-bg";
  wrap.innerHTML = `<div class="modal">
    <div class="h2" style="margin-bottom:14px;">Reject Timesheet Day</div>
    <div class="field"><label>Reason (sent to employee, required)</label><textarea id="rejReason" rows="3" placeholder="e.g. Clock-out time looks incorrect, please confirm"></textarea></div>
    <button class="btn btn-danger btn-block btn-lg" id="rejGo">Reject &amp; Notify Employee</button>
    <button class="btn btn-ghost btn-block" style="margin-top:8px;" id="rejCancel">Cancel</button>
  </div>`;
  document.body.appendChild(wrap);
  wrap.querySelector("#rejCancel").onclick=()=>wrap.remove();
  wrap.querySelector("#rejGo").onclick=()=>{
    const reason = wrap.querySelector("#rejReason").value;
    if(!reason){ toast("A reason is required"); return; }
    a.status="rejected"; a.rejectReason=reason;
    audit(DB.session.name,"Rejected timesheet", empName(a.employeeId), `${fmtDate(a.timeIn)}. Reason: ${reason}`);
    save(); wrap.remove(); toast("Rejected — employee notified"); go(route.name);
  };
}
function modalEditApproved(attId){
  const a = DB.attendance.find(x=>x.id===attId);
  const wrap = document.createElement("div"); wrap.className="modal-bg";
  wrap.innerHTML = `<div class="modal">
    <div class="h2" style="margin-bottom:14px;">Edit Approved Record</div>
    <div class="field"><label>Time Out</label><input type="time" id="editOut" value="${new Date(a.timeOut).toTimeString().slice(0,5)}"></div>
    <div class="field"><label>Reason for change (required)</label><textarea id="editReason" rows="2" placeholder="e.g. Employee forgot to clock out"></textarea></div>
    <button class="btn btn-accent btn-block btn-lg" id="editSave">Save &amp; Log Audit Record</button>
    <button class="btn btn-ghost btn-block" style="margin-top:8px;" id="editCancel">Cancel</button>
  </div>`;
  document.body.appendChild(wrap);
  wrap.querySelector("#editCancel").onclick=()=>wrap.remove();
  wrap.querySelector("#editSave").onclick=()=>{
    const reason = wrap.querySelector("#editReason").value;
    if(!reason){ toast("A reason is required for audit purposes"); return; }
    const [h,m] = wrap.querySelector("#editOut").value.split(":").map(Number);
    const oldOut = fmtTime(a.timeOut);
    const d = new Date(a.timeOut); d.setHours(h,m,0,0);
    a.timeOut = d.toISOString();
    a.grossMin = mins(new Date(a.timeOut)-new Date(a.timeIn));
    a.netMin = a.grossMin - (a.unpaidBreakMin||0);
    a.status = "corrected";
    audit(DB.session.name,"Changed Time Out", empName(a.employeeId), `Original: ${oldOut} → New: ${fmtTime(a.timeOut)}. Reason: ${reason}`);
    save(); wrap.remove(); toast("Updated — audit record created"); go("admin-att-detail",{id:attId});
  };
}
function modalManualEntry(empId){
  const e = DB.employees.find(x=>x.id===empId);
  const jobs = DB.jobs;
  const wrap = document.createElement("div"); wrap.className="modal-bg";
  wrap.innerHTML = `<div class="modal">
    <div class="h2" style="margin-bottom:14px;">Manual Attendance Entry</div>
    <div class="field"><label>Job</label><select id="meJob">${jobs.map(j=>`<option value="${j.id}">${escapeHtml(j.name)}</option>`).join("")}</select></div>
    <div class="grid2">
      <div class="field"><label>Date</label><input type="date" id="meDate" value="${new Date().toISOString().slice(0,10)}"></div>
      <div class="field"></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Time In</label><input type="time" id="meIn" value="08:00"></div>
      <div class="field"><label>Time Out</label><input type="time" id="meOut" value="16:30"></div>
    </div>
    <div class="field"><label>Reason (required — will be recorded in audit log)</label><textarea id="meReason" rows="2" placeholder="e.g. Phone died on site, entered manually from supervisor confirmation"></textarea></div>
    <button class="btn btn-accent btn-block btn-lg" id="meSave">Save Manual Entry</button>
    <button class="btn btn-ghost btn-block" style="margin-top:8px;" id="meCancel">Cancel</button>
  </div>`;
  document.body.appendChild(wrap);
  wrap.querySelector("#meCancel").onclick=()=>wrap.remove();
  wrap.querySelector("#meSave").onclick=()=>{
    const reason = wrap.querySelector("#meReason").value;
    if(!reason){ toast("Reason is required"); return; }
    const date = wrap.querySelector("#meDate").value;
    const [ih,im] = wrap.querySelector("#meIn").value.split(":").map(Number);
    const [oh,om] = wrap.querySelector("#meOut").value.split(":").map(Number);
    const ti = new Date(date); ti.setHours(ih,im,0,0);
    const to = new Date(date); to.setHours(oh,om,0,0);
    const gross = mins(to-ti);
    DB.attendance.push({id:uid("att"), employeeId:empId, jobId:wrap.querySelector("#meJob").value, timeIn:ti.toISOString(), timeOut:to.toISOString(),
      photoIn:null, photoOut:null, gpsIn:{lat:0,lng:0,address:"Manual entry — no GPS captured"}, gpsOut:null, geofence:"n/a",
      breakIds:[], grossMin:gross, unpaidBreakMin:0, paidBreakMin:0, netMin:gross, status:"submitted", source:"admin-manual", summary:reason});
    audit(DB.session.name,"Added manual attendance entry", e.name, `${date} ${wrap.querySelector("#meIn").value}-${wrap.querySelector("#meOut").value}. Reason: ${reason}`);
    save(); wrap.remove(); toast("Manual entry saved — pending approval"); go("admin-employee-detail",{id:empId});
  };
}
