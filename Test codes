  if($("viewPrivacy")) $("viewPrivacy").onclick = ()=> { PRIVACY_FROM_LOGIN=false; go("privacy"); };
  if($("logoutBtn")) $("logoutBtn").onclick = ()=> { audit(currentEmployee().name,"Logged out","Employee session",""); DB.session=null; save(); go("login"); };
