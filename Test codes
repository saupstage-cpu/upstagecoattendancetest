    <button class="btn btn-ghost btn-block" style="margin-top:8px;" id="reqCancel">Cancel</button>
  </div>`;
  document.body.appendChild(wrap);
  wrap.querySelector("#reqCancel").onclick=()=>wrap.remove();
  wrap.querySelector("#reqSend").onclick=()=>{
    const reason = wrap.querySelector("#reqReason").value;
    const time = wrap.querySelector("#reqTime").value;
    if(!reason || !time){ toast("Fill in both fields"); return; }
    const [h,m] = time.split(":").map(Number);
